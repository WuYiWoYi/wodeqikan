[gd_resource type="Resource" script_class="CultureDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/culture_definition.gd" id="1_culture"]

[resource]
script = ExtResource("1_culture")
culture_id = "CULTURE_BUGIDO"
display_name = "布吉多人"
description = "布吉多人一直是这片土地的所有者。\n\n但是200年前，多拉曼人的入侵让布吉多人失去了西北的大片土地，布吉多的贵族们只好撤退到中部的山谷中，依托险要的山势重新建立坚固的城堡，以抵抗多拉曼人的铁蹄。\n\n100年前的分裂虽然带走了部分贵族，但是剩下的人在弗拉尼家族的旗帜下，仍然以布吉多人正统自居，在山谷中维持统治。\n\n20年前，多拉曼人的君主和弗拉尼的王上签订了和平协定，但是这几年的边境摩擦不断加剧。\n\n这脆弱的和平，又能维持多久呢？"
talent_lines = PackedStringArray("城堡驻军薪资 -20%", "待设定：其余文化天赋尚未确定")
sort_order = 1
enabled = true
