[gd_resource type="Resource" script_class="IdentityDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/identity_definition.gd" id="1_identity"]

[resource]
script = ExtResource("1_identity")
identity_id = "ADVENTURER"
display_name = "冒险家"
category_id = "COMMONER"
description = "你走过不少地方，身上的伤疤比铜板多，靴子换了七八双，地图倒是攒了半箱子——可惜大半是错的。你见过沙漠里会唱歌的石头，也差点被山里的土匪扒了皮；你给商队当过护卫，替人寻过失踪的继承人，最惨的时候在酒馆里用一枚古币换了碗热汤。如今你回到这座边境小镇，本想歇歇脚，却听见邻桌有人在低声议论一桩“给大价钱”的差事。你端着酒杯侧耳听了几句，正琢磨要不要凑上去……"
sort_order = 0
enabled = true
