[gd_resource type="Resource" script_class="IdentityDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/identity_definition.gd" id="1_identity"]

[resource]
script = ExtResource("1_identity")
identity_id = "EXPEDITION_LEADER"
display_name = "远征军领队"
category_id = "NOBLE"
description = "另一片大陆的战报传来时，你正带着麾下这支杂牌军啃硬面包。远征军名义上为国王开疆拓土，实际上塞给你的尽是犯事的、欠债的、走投无路的，还有几个连名字都写不利索的愣头青。你带他们打过沼泽里的蛮族，也压过营啸的哗变，死掉的人你亲手埋过，活着的人叫你一声“头儿”。如今大陆那边又来了新命令，摊开的地图上标着一个谁都没听过的地方，副手凑过来低声问：“头儿，这趟咱们还回得来吗？”你盯着地图没吭声……"
sort_order = 1
enabled = true
