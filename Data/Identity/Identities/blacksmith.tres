[gd_resource type="Resource" script_class="IdentityDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/identity_definition.gd" id="1_identity"]

[resource]
script = ExtResource("1_identity")
identity_id = "BLACKSMITH"
display_name = "铁匠"
category_id = "COMMONER"
description = "你的铁匠铺开在镇子最热闹的路口，门口那口炉子烧了十几年，打出的犁头、马蹄铁和菜刀养活了一家人。你也打过兵器，镇上民兵的短剑、某个骑士老爷的马刺，甚至有一回给一个满身血的神秘人连夜修过一把砍豁了口的长剑——那人走后杳无音信，工钱也没给。这天清晨你刚拉开炉门，徒弟慌张地跑进来说，镇外来了几个骑马的，看旗号像是贵族的私兵，正一路打听镇子上“有没有个好铁匠”。你放下手里的锤子，往炉子里添了块炭……"
sort_order = 2
enabled = true
