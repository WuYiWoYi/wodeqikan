[gd_resource type="Resource" script_class="IdentityDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/identity_definition.gd" id="1_identity"]

[resource]
script = ExtResource("1_identity")
identity_id = "IDENTITY_ROGUE_KNIGHT"
display_name = "无赖骑士"
category_id = "COMMONER"
culture_id = "CULTURE_LORRIS"
description = "这个世界上，有成功就会有失败。\n\n你的家族原先也是布吉多人的贵族，100年前跟随南下派夺取蒙卡人的土地。\n\n但很不幸的是，你的曾祖父、祖父和父亲都在和蒙卡人的作战中倒下……\n\n当你得知你父亲的死讯时，你才16岁。\n\n而你继承到的，没有爵位，没有土地，只有一套旧盔甲。\n\n你也不知道你的家族该何去何从。\n\n除了一身从小习得的武艺，你一无所有……"
bonus_lines = PackedStringArray("待设定：身份加成尚未确定")
sort_order = 1
enabled = true
