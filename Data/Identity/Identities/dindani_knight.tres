[gd_resource type="Resource" script_class="IdentityDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Config/identity_definition.gd" id="1_identity"]

[resource]
script = ExtResource("1_identity")
identity_id = "IDENTITY_DINDANI_KNIGHT"
display_name = "丁达尼家族骑士"
category_id = "NOBLE"
culture_id = "CULTURE_BUGIDO"
description = "丁达尼家族是这片大陆上最古老的血脉之一。\n\n你的家族世代在这片土地上收税、打猎和举办丰收庆典……\n\n但是200年前一切都变了。\n\n多拉曼人带着军队从北方的海上而来，布吉多人尽管联合在了一起，但是仍然不敌。\n\n你们家族只好退守山谷，并且跟随弗拉尼家族建立王国。\n\n你的家族在平原和山谷交界处建立新的丁达尼堡垒，站在抵抗多拉曼人的第一线。"
bonus_lines = PackedStringArray("待设定：身份加成尚未确定")
sort_order = 0
enabled = true
